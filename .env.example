# PROMETHEUS IGNIS — configuración pública del frontend (sin secretos).
# Copia este archivo a `.env` y ajusta los valores para tu entorno.
# OJO: las variables VITE_* se incluyen en el bundle público; nunca coloques
# claves, tokens ni credenciales aquí.

# URL base del Backend-API (sin barra final, sin el prefijo /api/v1).
# Filesystem local por defecto según el contrato del backend (v0.1.0).
VITE_API_BASE_URL=http://127.0.0.1:8000
